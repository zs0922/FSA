+	set_property -dict [list \
+		TARGET_LANGUAGE {Verilog} \
+		DEFAULT_LIB {xil_defaultlib} \
+		IP_REPO_PATHS $ipdir \
+		] [current_project]
+}
 
 if {[get_filesets -quiet sources_1] eq ""} {
