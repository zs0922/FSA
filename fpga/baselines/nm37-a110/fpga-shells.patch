+# Set the board part if available; else just use the part (already set by create_project)
+if {[catch {set_property -dict [list \
 	BOARD_PART $part_board \
 	TARGET_LANGUAGE {Verilog} \
 	DEFAULT_LIB {xil_defaultlib} \
 	IP_REPO_PATHS $ipdir \
