+// Vivado requires non-empty module bodies for instantiated modules.
+// These modules were optimized away by Chisel/CIRCT but their
+// instantiations remain in the generated netlist.
+module Queue2_UInt1();
+  wire _unused = 1'b0;
+endmodule
+
+module Queue2_UInt1_1();
+  wire _unused = 1'b0;
+endmodule
