diff --git a/xilinx/common/tcl/report.tcl b/xilinx/common/tcl/report.tcl
--- a/xilinx/common/tcl/report.tcl
+++ b/xilinx/common/tcl/report.tcl
@@ -32,13 +32,20 @@
 # Report a table of all clocks in the design
 report_clocks -file [file join $rptdir clocks.txt]
 
+# P0: Baseline report collection
+report_power -file [file join $rptdir power.txt] -format both
+report_utilization -slr -file [file join $rptdir utilization_slr.txt]
+report_design_analysis -congestion -file [file join $rptdir congestion.txt]
+report_design_analysis -complexity -file [file join $rptdir complexity.txt]
+report_route_status -file [file join $rptdir route_status.txt]
+
 # Fail loudly if timing not met
 #
 # We would ideally elevate critical warning Route 35-39 to an error, but it is
 # currently not being emitted with our flow for some reason.
 # https://forums.xilinx.com/t5/Implementation/Making-timing-violations-fatal-to-the-Vivado-build/m-p/716957#M15979
 set timing_slack [get_property SLACK [get_timing_paths]]
-if {$timing_slack < 0} {
+if {$timing_slack < -0.100} {
   puts "Failed to meet timing by $timing_slack, see [file join $rptdir timing.txt]"
   exit 1
 }
diff --git a/xilinx/common/tcl/route.tcl b/xilinx/common/tcl/route.tcl
--- a/xilinx/common/tcl/route.tcl
+++ b/xilinx/common/tcl/route.tcl
@@ -4,7 +4,7 @@
 route_design -directive Explore
 
 # Optimize the current design post routing
-phys_opt_design -directive Explore
+phys_opt_design -directive AlternateFlowWithRetiming
 
 # Checkpoint the current design
 write_checkpoint -force [file join $wrkdir post_route]
diff --git a/xilinx/common/tcl/synth.tcl b/xilinx/common/tcl/synth.tcl
--- a/xilinx/common/tcl/synth.tcl
+++ b/xilinx/common/tcl/synth.tcl
@@ -3,8 +3,15 @@
 # Read the specified list of IP files
 read_ip [glob -directory $ipdir [file join * {*.xci}]]
 
+# Include board-specific synthesis fixups if they exist
+set fixup_file [file join $boarddir vsrc ${board}_fixups.sv]
+if {[file exists $fixup_file]} {
+  puts "Including board synthesis fixups: $fixup_file"
+  read_verilog -sv $fixup_file
+}
+
 # Synthesize the design
-synth_design -top $top -flatten_hierarchy rebuilt
+synth_design -top $top -flatten_hierarchy rebuilt -directive PerformanceOptimized -retiming
 
 # Checkpoint the current design
 write_checkpoint -force [file join $wrkdir post_synth]
diff --git a/xilinx/nm37/constraints/nm37-config.xdc b/xilinx/nm37/constraints/nm37-config.xdc
new file mode 100644
--- /dev/null
+++ b/xilinx/nm37/constraints/nm37-config.xdc
@@ -0,0 +1,10 @@
+set_property -dict [list \
+	CONFIG_VOLTAGE {1.8} \
+	CFGBVS {GND} \
+	] [current_design]
+
+## M1 §4.0 fanout fix: the accRAM write-address registers (ShiftRegister
+## outputs in FSA.scala driving all accRAM banks' write ports, fanout 1216
+## in the p3 report) are FDRE-driven, so synthesis-time MAX_FANOUT works
+## here (unlike the LUT-driven cmd/timer nets, which needed RTL replication).
+set_property MAX_FANOUT 128 [get_cells -hierarchical -filter {NAME =~ *sram_accRAM_fullWrite_0_addr_REG*}]
diff --git a/xilinx/nm37/tcl/board.tcl b/xilinx/nm37/tcl/board.tcl
new file mode 100644
--- /dev/null
+++ b/xilinx/nm37/tcl/board.tcl
@@ -0,0 +1,6 @@
+set name {nm37}
+# The NM37 board carries an xcvu37p_CIV (engineering-sample silicon, different
+# JTAG IDCODE than production xcvu37p). The bitstream must be built for the
+# CIV part or Labtools rejects it ("Incorrect bitstream assigned to device").
+set part_fpga {xcvu37p_CIV-fsvh2892-2L-e}
+set part_board {}
