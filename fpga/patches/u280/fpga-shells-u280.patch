diff --git a/xilinx/u280/vsrc/u280_fixups.sv b/xilinx/u280/vsrc/u280_fixups.sv
new file mode 100644
index 0000000..c6d2ea1
--- /dev/null
+++ b/xilinx/u280/vsrc/u280_fixups.sv
@@ -0,0 +1,10 @@
+// Vivado requires non-empty module bodies for instantiated modules.
+// These modules were optimized away by Chisel/CIRCT but their
+// instantiations remain in the generated netlist.
+module Queue2_UInt1();
+  wire _unused = 1'b0;
+endmodule
+
+module Queue2_UInt1_1();
+  wire _unused = 1'b0;
+endmodule
