{
  "schema_version": 1,
  "metric_definitions": {
    "execTime": "DUT clock edges for which AXI4FSA state == s_active, including the active edge accepting stop fence; includes instruction ingress, dependency, DMA and compute waits. Not arithmetic-only latency.",
    "mxActive": "DUT edges inside s_active for which fsa.io.busy is true; union of matrix controller busy periods, not a sum of per-PE work.",
    "dmaActive": "DUT edges inside s_active for which dma.module.io.active is true.",
    "mxBubble": "DUT edges inside s_active after firstInstFire, with fsa.io.inst.ready && !fsa.io.inst.valid. Not all idle cycles; may overlap mxActive or dmaActive.",
    "rawInst": "raw instruction queue dequeue handshakes while active; this counter counts instruction beats as defined by this interface.",
    "mxInst": "matrix instruction acceptance handshakes while active.",
    "dmaInst": "DMA instruction acceptance handshakes while active.",
    "fence": "decoded fence acceptance handshakes while active.",
    "testbench_total_cycles": "TestDriver.trace_count increments at every testbench clock posedge from simulation start, including reset and harness/input/output activity. Its clock can differ from the DUT clock; do not convert it using DUT frequency or substitute it for execTime."
  },
  "source_definitions": [
    "generators/fsa/src/main/scala/fsa/AXI4FSA.scala:71-78,179-214",
    "generated gen-collateral/TestDriver.v:119-158"
  ],
  "caveats": [
    "No process wall-clock time is used as hardware performance.",
    "mxActive, dmaActive and mxBubble are not mutually exclusive; do not sum them into execTime.",
    "Compare fixed array dimensions, sequence, datatypes and identical inst/mem bytes. A different array size changes head_dim and workload.",
    "Frequency conversion is conditional on the supplied DUT frequency being achieved; it is a cycle-budget estimate under this simulator, not measured board throughput.",
    "The old pipeline A100 physical result is bound to its A/sim16 datapath; 4x4 and8x8 are functional scaling configurations, not separately timed board implementations."
  ],
